# Atmosyn Official Environment Configuration Template
# No secrets or private API keys should ever be committed to source control.

# Site URL
NEXT_PUBLIC_SITE_URL=https://atmosyn.org

# Collaboration inquiry delivery endpoint (REQUIRED for the contact form to work).
# Until this is set, /api/collaboration answers honestly with 503 instead of
# pretending the submission was stored.
# Accepts any endpoint that takes a JSON POST, e.g.:
#   - Slack incoming webhook:      https://hooks.slack.com/services/XXX/YYY/ZZZ
#   - Discord webhook:             https://discord.com/api/webhooks/XXX/YYY
#   - Formspree form endpoint:     https://formspree.io/f/XXXXXXX
#   - Make/Zapier webhook, or your own API
COLLABORATION_WEBHOOK_URL=
